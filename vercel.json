{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/b",
      "destination": "/api/b"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "{assets/fotos/**,api/_fonts/**}"
    },
    "api/pedido.js": {
      "includeFiles": "data/campanas.json"
    }
  }
}
